{
	auto_https disable_redirects
	log default {
		format filter {
			request delete
		}
	}
}

http://{$API_DOMAIN_NAME} {
	redir https://{$API_DOMAIN_NAME}{uri} permanent
}

https://{$API_DOMAIN_NAME} {
	encode zstd gzip

	# Preserve the security boundary before the catch-all proxy. Caddy normally
	# sorts `handle` ahead of `respond`, regardless of their source order.
	route {
		@actuator path /actuator /actuator/*
		respond @actuator 404

		handle /healthz {
			rewrite * /actuator/health
			reverse_proxy api:8080
		}

		# Spring prefers Forwarded over the X-Forwarded-For that Caddy sets, so a client
		# could pick its own IP. Rate limits depend on that value. The other forwarded
		# headers would let a client rewrite the request path and URL Spring sees.
		handle {
			reverse_proxy api:8080 {
				header_up -Forwarded
				header_up -X-Real-IP
				header_up -X-Forwarded-Prefix
				header_up -X-Forwarded-Port
				header_up -X-Forwarded-Ssl
			}
		}
	}
}
